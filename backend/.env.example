# Variables d'environnement — copier en .env et compléter avant de lancer le projet.
# Toutes les clés métier de ce projet sont nommées en français (section 6.3).

DATABASE_URL=
REDIS_URL=
JWT_SECRET=
# Durée de validité des jetons JWT (API stateless — voir module utilisateurs).
JWT_EXPIRES_IN=7d
# Port d'écoute du backend (≥ 2 instances derrière load balancer en prod).
PORT=3001

PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
PAYDUNYA_API_KEY=

DAILY_CO_API_KEY=
QURANHUB_API_URL=

STOCKAGE_R2_BUCKET=
STOCKAGE_R2_ACCESS_KEY=
STOCKAGE_R2_SECRET_KEY=

# Emails transactionnels — Brevo (anciennement Sendinblue)
EMAIL_API_KEY=
EMAIL_EXPEDITEUR_EMAIL=contact@equran-academy.com
EMAIL_EXPEDITEUR_NOM="E-Quran Academy"
FRONTEND_URL=http://localhost:3000

# Seed administrateur (cf. prisma/seed.ts). Laisser vide pour ne créer aucun
# admin au premier lancement.
ADMIN_EMAIL=
ADMIN_MOT_DE_PASSE=
ADMIN_NOM_COMPLET=

# Classe virtuelle — Daily.co (visioconférence SFU). Laisser vide en dev pour
# utiliser le mode placeholder (aucun appel réseau).
DAILY_API_KEY=
# Port du serveur WebSocket (synchronisation du Mushaf).
PORT_WS=3002
# Origines autorisées pour le WebSocket (séparées par des virgules).
CORS_ORIGINE=http://localhost:3000
