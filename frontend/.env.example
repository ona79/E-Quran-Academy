# URL du backend NestJS (≥ 2 instances derrière load balancer en prod).
# En dev local, le frontend proxy les requêtes via /api-backend (cf. next.config.mjs).
NEXT_PUBLIC_API_URL=http://localhost:3001

# URL WebSocket du backend (synchronisation du Mushaf en salle de classe).
NEXT_PUBLIC_WS_URL=http://localhost:3002
